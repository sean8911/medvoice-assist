# No API key is required. These settings are optional overrides.
MEDICAL_CHATBOT_DEVICE=auto
MEDICAL_CHATBOT_EMERGENCY_NUMBER=999
MEDICAL_CHATBOT_URGENT_SERVICE=a same-day medical service
MEDICAL_CHATBOT_MINIMUM_SCORE=0.50
MEDICAL_CHATBOT_MINIMUM_MARGIN=0.10
MEDICAL_CHATBOT_MINIMUM_SYMPTOMS=2
MEDICAL_CHATBOT_MAX_QUESTIONS=1

# Defaults to the trained model already stored in this thesis workspace.
# MEDICAL_CHATBOT_BIOBERT_MODEL=C:\path\to\outputs\models\biobert

# Public Whisper is downloaded once and cached locally.
MEDICAL_CHATBOT_WHISPER_MODEL=openai/whisper-small
